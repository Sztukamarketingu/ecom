# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

COPY app/package*.json ./
RUN npm ci

COPY app/ ./
ARG VITE_N8N_WEBHOOK_URL
ARG VITE_LLM_PROXY_URL
ARG VITE_TIDYCAL_PATH
ARG VITE_APP_TITLE
ARG VITE_ANALYTICS_ENDPOINT
ARG VITE_REPORT_LANGUAGE
ARG VITE_REPORT_ONLY_MODE

ENV VITE_N8N_WEBHOOK_URL=${VITE_N8N_WEBHOOK_URL}
ENV VITE_LLM_PROXY_URL=${VITE_LLM_PROXY_URL}
ENV VITE_TIDYCAL_PATH=${VITE_TIDYCAL_PATH}
ENV VITE_APP_TITLE=${VITE_APP_TITLE}
ENV VITE_ANALYTICS_ENDPOINT=${VITE_ANALYTICS_ENDPOINT}
ENV VITE_REPORT_LANGUAGE=${VITE_REPORT_LANGUAGE}
ENV VITE_REPORT_ONLY_MODE=${VITE_REPORT_ONLY_MODE}

RUN npm run build

# Serve stage
FROM nginx:alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
